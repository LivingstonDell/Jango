# Shared production runtime values for <SLURM_NODE>. Backend-specific files source this file.
export PROTEINMPNN_HOME=${PROTEINMPNN_HOME:-/path/to/tools/ProteinMPNN}
export PROTEINMPNN_PYTHON=${PROTEINMPNN_PYTHON:-/path/to/miniforge3/envs/proteinmpnn/bin/python}
export PROTEINMPNN_RUNNER=${PROTEINMPNN_RUNNER:-/path/to/tools/ProteinMPNN/protein_mpnn_run.py}

export ROSETTA_RUNTIME=${ROSETTA_RUNTIME:-apptainer}
export ROSETTA_IMAGE=${ROSETTA_IMAGE:-docker://rosettacommons/rosetta:latest}
export APPTAINER_BIN=${APPTAINER_BIN:-/usr/bin/apptainer}
export APPTAINER_CACHEDIR=${APPTAINER_CACHEDIR:-/path/to/jango_runs/cache/apptainer}

export DOCKQ_PROVIDER=${DOCKQ_PROVIDER:-dockq_rs_python}
export DOCKQ_PYTHON=${DOCKQ_PYTHON:-/path/to/tools/DockQ-RS/bin/python}
export DOCKQ_PRESERVATION_THRESHOLD=${DOCKQ_PRESERVATION_THRESHOLD:-0.49}
export DOCKQ_HIGH_QUALITY_THRESHOLD=${DOCKQ_HIGH_QUALITY_THRESHOLD:-0.80}

export ANARCI_PYTHON=${ANARCI_PYTHON:-/path/to/miniforge3/envs/bio-utils/bin/python}
export ANARCI_BIN=${ANARCI_BIN:-/path/to/miniforge3/envs/bio-utils/bin/ANARCI}

export EXECUTION_MODE=${EXECUTION_MODE:-slurm}
export SLURM_PARTITION=${SLURM_PARTITION:-batch}
export SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-8}
export SLURM_MEM=${SLURM_MEM:-20G}
export SLURM_TIME=${SLURM_TIME:-08:00:00}
export SLURM_MAX_CONCURRENT=${SLURM_MAX_CONCURRENT:-1}
export FOLD_WORKERS_PER_GPU=${FOLD_WORKERS_PER_GPU:-1}
export SLURM_BUNDLE_MODE=${SLURM_BUNDLE_MODE:-combined}

# Production OpenDDE runtime values for <SLURM_NODE>.
_this_config_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/production/runtime.<SLURM_NODE>.common.env
source "${_this_config_dir}/runtime.<SLURM_NODE>.common.env"
unset _this_config_dir

export FOLDING_BACKEND=opendde
export JANGO_RUNTIME_CONFIG=configs/production/opendde.env
export SLURM_GPUS=${SLURM_GPUS:-1}

export OPENDDE_PYTHON=${OPENDDE_PYTHON:-/path/to/miniforge3/envs/opendde/bin/python}
export OPENDDE_EXECUTABLE=${OPENDDE_EXECUTABLE:-/path/to/miniforge3/envs/opendde/bin/opendde}
export OPENDDE_ROOT_DIR=${OPENDDE_ROOT_DIR:-/path/to/models/opendde}
export OPENDDE_CHECKPOINT=${OPENDDE_CHECKPOINT:-/path/to/models/opendde/checkpoint/opendde.pt}
export OPENDDE_MODEL_NAME=${OPENDDE_MODEL_NAME:-opendde_v1}
export OPENDDE_SEEDS=${OPENDDE_SEEDS:-101}
export OPENDDE_CYCLE=${OPENDDE_CYCLE:-10}
export OPENDDE_STEP=${OPENDDE_STEP:-200}
export OPENDDE_SAMPLES=${OPENDDE_SAMPLES:-5}
export OPENDDE_DTYPE=${OPENDDE_DTYPE:-fp32}
if [ -z "${OPENDDE_RUNNER:-}" ]; then
  export OPENDDE_RUNNER='${JANGO_SOURCE}/scripts/nbia/run_opendde_monomer.py'
fi

export JANGO_DATA_ROOT=${JANGO_DATA_ROOT:-/path/to/jango_runs/data}
export MSA_PROVIDER=${MSA_PROVIDER:-abforge_get_or_build}
export MSA_SCRIPT=${MSA_SCRIPT:-/path/to/AbForge/scripts/get_or_build_msa.py}
export MSA_CACHE_ROOT=${MSA_CACHE_ROOT:-${JANGO_DATA_ROOT}/msa}
export MSA_FORMAT=${MSA_FORMAT:-a3m}
export MSA_PAIRING=${MSA_PAIRING:-unpaired}
export MSA_TOOL=${MSA_TOOL:-opendde}
export MSA_REQUIRE=${MSA_REQUIRE:-true}
export MSA_BUILD_IF_MISSING=${MSA_BUILD_IF_MISSING:-false}
export MSA_FAILURE_POLICY=${MSA_FAILURE_POLICY:-skip_design}
export MSA_DESIGN_POLICY=${MSA_DESIGN_POLICY:-native_reuse}

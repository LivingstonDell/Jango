# Production path template. Fett supplies run-specific values from --run-id and --input.
# For direct shell use, export JANGO_RUN_NAME and JANGO_RAW_TARBALLS before sourcing.
# No generated work, data, results, caches, or logs may live inside /path/to/jango.
export JANGO_SOURCE=${JANGO_SOURCE:-/path/to/jango}
export JANGO_WORK_ROOT=${JANGO_WORK_ROOT:-/path/to/jango_runs/work}
export JANGO_OUTPUTS_ROOT=${JANGO_OUTPUTS_ROOT:-/path/to/jango_runs/outputs}
export JANGO_DATA_ROOT=${JANGO_DATA_ROOT:-/path/to/jango_runs/data}
export JANGO_MPNN_ROOT=${JANGO_MPNN_ROOT:-${JANGO_DATA_ROOT}/mpnn}
export JANGO_FOLD_ROOT=${JANGO_FOLD_ROOT:-${JANGO_DATA_ROOT}/folds}
if [ -z "${JANGO_RUN_ROOT:-}" ] && [ -n "${JANGO_RUN_NAME:-}" ]; then
  export JANGO_RUN_ROOT=${JANGO_WORK_ROOT}/${JANGO_RUN_NAME}
elif [ -n "${JANGO_RUN_ROOT:-}" ]; then
  export JANGO_RUN_ROOT
fi
if [ -z "${JANGO_OUTPUT_ROOT:-}" ] && [ -n "${JANGO_RUN_ROOT:-}" ]; then
  export JANGO_OUTPUT_ROOT=${JANGO_RUN_ROOT}
elif [ -n "${JANGO_OUTPUT_ROOT:-}" ]; then
  export JANGO_OUTPUT_ROOT
fi
export JANGO_SOURCE_LABEL=${JANGO_SOURCE_LABEL:-sabdab2}
export JANGO_RAW_TARBALLS=${JANGO_RAW_TARBALLS:-${JANGO_DATA_ROOT}/tarballs}
export JANGO_PATHS_CONFIG=configs/production/paths.env

# Production Boltz2 runtime values for <SLURM_NODE>.
_this_config_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=configs/production/runtime.<SLURM_NODE>.common.env
source "${_this_config_dir}/runtime.<SLURM_NODE>.common.env"
unset _this_config_dir

export FOLDING_BACKEND=boltz2
export JANGO_RUNTIME_CONFIG=configs/production/boltz2.env
export SLURM_GPUS=${SLURM_GPUS:-1}

export BOLTZ_EXECUTABLE=${BOLTZ_EXECUTABLE:-/path/to/miniforge3/envs/boltz2/bin/boltz}
export BOLTZ_PYTHON=${BOLTZ_PYTHON:-/path/to/miniforge3/envs/boltz2/bin/python}
export BOLTZ_MODEL_ROOT=${BOLTZ_MODEL_ROOT:-/path/to/models/boltz}
export BOLTZ_CACHE=${BOLTZ_CACHE:-/path/to/jango_runs/cache/boltz}

export MSA_PROVIDER=${MSA_PROVIDER:-backend_managed}
export MSA_REQUIRE=${MSA_REQUIRE:-false}
export MSA_BUILD_IF_MISSING=${MSA_BUILD_IF_MISSING:-false}

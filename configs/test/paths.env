export JANGO_PATHS_CONFIG=configs/test/paths.env
export JANGO_SOURCE=/path/to/jango
export JANGO_WORK_ROOT=/path/to/jango_runs/work
export JANGO_OUTPUTS_ROOT=/path/to/jango_runs/outputs
export JANGO_DATA_ROOT=/path/to/jango_runs/data
export JANGO_MPNN_ROOT=$JANGO_DATA_ROOT/mpnn

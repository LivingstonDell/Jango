# Example path configuration. Copy into configs/test/ or configs/production/ and edit.
# Generated work, outputs, caches, and logs must remain outside /path/to/jango.
export JANGO_SOURCE=/path/to/jango
export JANGO_WORK_ROOT=/path/to/jango_runs/work
export JANGO_OUTPUTS_ROOT=/path/to/jango_runs/outputs
export JANGO_DATA_ROOT=/path/to/jango_runs/data
export JANGO_MPNN_ROOT=${JANGO_DATA_ROOT}/mpnn
export JANGO_FOLD_ROOT=${JANGO_DATA_ROOT}/folds
export JANGO_TEST_RUN_ROOT=${JANGO_WORK_ROOT}/${JANGO_RUN_NAME:-example-smoke}
export JANGO_RUN_ROOT=${JANGO_WORK_ROOT}/${JANGO_RUN_NAME:-example-production}
export JANGO_SOURCE_LABEL=sabdab2
export JANGO_RAW_TARBALLS=${JANGO_DATA_ROOT}/tarballs

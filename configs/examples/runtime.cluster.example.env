# Example <SLURM_NODE> runtime configuration. Copy and edit before launching workloads.
# Canonical sourcing sequence:
#   source /path/to/miniforge3/etc/profile.d/conda.sh
#   conda activate jango
#   cd /path/to/jango
#   set -a
#   source configs/<test-or-production>/paths.env
#   source configs/<test-or-production>/<backend>.env
#   set +a

export PROTEINMPNN_HOME=/path/to/tools/ProteinMPNN
export PROTEINMPNN_PYTHON=/path/to/miniforge3/envs/proteinmpnn/bin/python
export PROTEINMPNN_RUNNER=/path/to/tools/ProteinMPNN/protein_mpnn_run.py

# Select one backend: esmfold2, boltz2, or opendde.
export FOLDING_BACKEND=esmfold2
export ESMFOLD2_PYTHON=/path/to/miniforge3/envs/esmfold2/bin/python
export ESM_ROOT=/path/to/esmfold2
export ESMFOLD2_MODEL=Biohub/ESMFold2
export ESMFOLD2_CACHE=/path/to/hf_cache
export ESMC_MODEL_PATH=/path/to/hf_cache/hub/models--biohub--ESMC-6B/snapshots/<snapshot-id>
export ESMFOLD2_DEVICE=cuda

# OpenDDE backend values, used when FOLDING_BACKEND=opendde.
export OPENDDE_PYTHON=/path/to/miniforge3/envs/opendde/bin/python
export OPENDDE_EXECUTABLE=/path/to/miniforge3/envs/opendde/bin/opendde
export OPENDDE_ROOT_DIR=/path/to/models/opendde
export OPENDDE_CHECKPOINT=/path/to/models/opendde/checkpoint/opendde.pt
export OPENDDE_MODEL_NAME=opendde_v1

export JANGO_DATA_ROOT=${JANGO_DATA_ROOT:-/path/to/jango_runs/data}
export MSA_PROVIDER=abforge_get_or_build
export MSA_SCRIPT=/path/to/AbForge/scripts/get_or_build_msa.py
export MSA_CACHE_ROOT=${MSA_CACHE_ROOT:-${JANGO_DATA_ROOT}/msa}
export MSA_FORMAT=a3m
export MSA_PAIRING=unpaired
# Use opendde here when FOLDING_BACKEND=opendde.
export MSA_TOOL=esmfold2
export MSA_REQUIRE=true
export MSA_BUILD_IF_MISSING=false
export MSA_FAILURE_POLICY=skip_design
export MSA_DESIGN_POLICY=native_reuse

export ROSETTA_RUNTIME=apptainer
export ROSETTA_IMAGE=docker://rosettacommons/rosetta:latest
export APPTAINER_BIN=/usr/bin/apptainer
export APPTAINER_CACHEDIR=/path/to/jango_runs/cache/apptainer

export DOCKQ_PROVIDER=dockq_rs_python
export DOCKQ_PYTHON=/path/to/tools/DockQ-RS/bin/python
export DOCKQ_PRESERVATION_THRESHOLD=0.49

export ANARCI_PYTHON=/path/to/miniforge3/envs/bio-utils/bin/python
export ANARCI_BIN=/path/to/miniforge3/envs/bio-utils/bin/ANARCI

export EXECUTION_MODE=slurm
export SLURM_PARTITION=batch
export SLURM_GPUS=1
export SLURM_CPUS_PER_TASK=8
export SLURM_MEM=20G
export SLURM_TIME=08:00:00
export SLURM_MAX_CONCURRENT=1
export FOLD_WORKERS_PER_GPU=1
export SLURM_BUNDLE_MODE=combined
